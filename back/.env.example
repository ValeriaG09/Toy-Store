# Configuración del servidor
PORT=5000

# URL del Frontend (ej. https://tu-app.vercel.app para prod, http://localhost:5173 para dev)
FRONTEND_URL=https://toy-store-red-mu.vercel.app

# Configuración de Base de Datos PostgreSQL (Supabase/Render)
# Formato: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL=postgresql://postgres.xxx:tu_password_aqui@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Configuración de Correos (Nodemailer)
EMAIL_USER=toystorexoxo@gmail.com
EMAIL_PASSWORD=tu_app_password_de_google

# Autenticación y Seguridad
JWT_SECRET=tu_clave_secreta_super_segura
ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com

# Google OAuth
GOOGLE_CLIENT_ID=tu_client_id_de_google
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google

# IA y APIs Externas
FAL_KEY=tu_fal_key
